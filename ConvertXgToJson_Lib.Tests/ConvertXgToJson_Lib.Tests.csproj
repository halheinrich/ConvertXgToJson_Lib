<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>ConvertXgToJson_Lib.Tests</RootNamespace>
    <AssemblyName>ConvertXgToJson_Lib.Tests</AssemblyName>
    <!-- Tests keep warnings-as-errors (Directory.Build.props) but opt out of
         doc-file generation: test method names are the documentation, and
         CS1591 on every [Fact] would demand boilerplate docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <ProjectReference Include="..\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestData\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="TestData\Output\" />
  </ItemGroup>
</Project>