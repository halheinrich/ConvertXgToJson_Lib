<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>ConvertXgToJson_Lib.Tests</RootNamespace>
    <AssemblyName>ConvertXgToJson_Lib.Tests</AssemblyName>
    <!-- Tests keep warnings-as-errors (Directory.Build.props) but opt out of
         doc-file generation: test method names are the documentation, and
         CS1591 on every [Fact] would demand boilerplate docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <!-- The producer's record builders (TestRecords): the one way a test
         builds a record, so no test here restates the records' construction
         (BgDataTypes_Lib INSTRUCTIONS.md, "The test-support project"). -->
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
    <ProjectReference Include="..\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
    <!-- This repository's own test support: XgFileEditsTests pins its edits
         through the walk, and TestSupportPostureTests its posture. -->
    <ProjectReference Include="..\ConvertXgToJson_Lib.TestSupport\ConvertXgToJson_Lib.TestSupport.csproj" />
  </ItemGroup>
  <!-- The two project files the posture pins read, linked (not copied into
       source control) and staged beside the test assembly, so the pins read
       the files the projects are actually built from. Moving or renaming
       either breaks this build rather than a test at runtime. -->
  <ItemGroup>
    <None Include="..\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj"
          Link="Posture\ConvertXgToJson_Lib.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ConvertXgToJson_Lib.TestSupport\ConvertXgToJson_Lib.TestSupport.csproj"
          Link="Posture\ConvertXgToJson_Lib.TestSupport.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestData\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="TestData\Output\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pre-change captures of XgFileReader.ToJson over FixtureFiles — the
         JSON document contract JsonContractTests pins. Regenerate only for a
         deliberate, documented contract change. -->
    <EmbeddedResource Include="Golden\*.json" LogicalName="Golden.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>